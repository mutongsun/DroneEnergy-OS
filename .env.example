# 环境变量模板：复制为 .env 后按环境填写
#   cp .env.example .env
# .env 已被 .gitignore 排除，永不入库（secrets 只进服务器/GitHub Secrets）

# MySQL root 密码（mysql 服务初始化 + backend 连接串共用，改一处生效）
# - 本地开发：保持默认 root123 可不建 .env（与已初始化的数据卷兼容）
# - 服务器部署：必须改为强密码（首次 up 时数据卷初始化会读取它）
MYSQL_ROOT_PASSWORD=root123

# DeepSeek API Key（AI 诊断用；留空时后端自动走本地规则 fallback）
DEEPSEEK_API_KEY=

# JWT 签名密钥（服务器部署必须改为随机长串，如 openssl rand -hex 32 生成）
JWT_SECRET=change-me-in-prod

# 模拟器上报账号（与 backend seed 的演示账号对应）
API_USER=operator
API_PASSWORD=operator123
